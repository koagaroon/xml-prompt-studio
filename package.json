{
  "name": "xml-prompt-studio",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "packageManager": "npm@11.19.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:ts7 && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons:generate": "node scripts/generate-icon-assets.mjs",
    "icons:check": "node scripts/generate-icon-assets.mjs --check",
    "test": "npm run test:js && npm run test:rs",
    "test:js": "vitest run",
    "test:rs": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "lint:js": "eslint . && prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --locked --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:rs",
    "lint:fix": "eslint . --fix && prettier --write . && stylelint \"src/**/*.css\" --fix && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "typecheck:versions": "node scripts/verify-typescript-toolchains.mjs",
    "typecheck:ts6": "node ./node_modules/typescript/bin/tsc6 --project tsconfig.json && node ./node_modules/typescript/bin/tsc6 --project tsconfig.node.json",
    "typecheck:ts7": "node ./node_modules/@typescript/native/bin/tsc --project tsconfig.ts7.json && node ./node_modules/@typescript/native/bin/tsc --project tsconfig.ts7.node.json",
    "typecheck:all": "npm run typecheck:versions && npm run typecheck:ts7 && npm run typecheck:ts6",
    "check:dependency-currency": "node scripts/check-dependency-currency.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
