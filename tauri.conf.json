{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "XML Prompt Studio",
  "version": "0.1.0",
  "identifier": "com.codex.xmlpromptstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "title": "XML Prompt Studio",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
